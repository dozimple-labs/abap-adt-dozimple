{
  "name": "@dozimple/abap-adt",
  "version": "1.6.1",
  "description": "DoZimple MCP server for SAP ABAP: multi-system, secure by design — code review, ATC, diagnosis and documentation for ECC and S/4HANA",
  "keywords": [
    "sap",
    "abap",
    "adt",
    "mcp",
    "model-context-protocol",
    "dozimple"
  ],
  "homepage": "https://dozimple.cl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dozimple-labs/abap-adt-dozimple.git"
  },
  "bugs": {
    "url": "https://github.com/dozimple-labs/abap-adt-dozimple/issues"
  },
  "type": "module",
  "bin": {
    "abap-adt-dozimple": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/scripts/gen-docs.js",
    "config/systems.example.json",
    "scripts/set-password.sh",
    "docs/TOOLS.md",
    "docs/THREAT_MODEL.md",
    "README.es.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node dist/scripts/smoke.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "security": "npm audit --omit=dev --audit-level=high && npm audit signatures && node scripts/scan-sensitive.mjs && node scripts/scan-sensitive.mjs --history",
    "check": "npm test && npm run build && npm run security",
    "docs": "npm run build && node dist/scripts/gen-docs.js",
    "audit:verify": "node dist/scripts/audit-verify.js",
    "sbom": "npm sbom --omit=dev --sbom-format=cyclonedx --sbom-type=application > sbom.cdx.json",
    "hooks": "git config core.hooksPath .githooks && echo \"hooks activos: pre-commit (código completo) y pre-push (historial)\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "abap-adt-api": "8.4.3",
    "axios": "1.20.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "license": "Apache-2.0",
  "author": "DoZimple (https://dozimple.cl)"
}
